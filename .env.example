# Server
PORT=3001
NODE_ENV=production
CORS_ORIGINS=https://arena.northstar.gg

# Database (Render provides this)
DATABASE_URL=postgresql://user:pass@host:5432/arena

# Base Chain
BASE_RPC_URL=https://mainnet.base.org
NORTH_TOKEN_ADDRESS=0x...deployed_token_address
HOT_WALLET_PRIVATE_KEY=0x...private_key_for_withdrawals
MASTER_DEPOSIT_ADDRESS=0x...address_users_deposit_to

# Frontend (Vercel)
NEXT_PUBLIC_SERVER_URL=https://api.arena.northstar.gg
NEXT_PUBLIC_WS_URL=wss://api.arena.northstar.gg/ws/arena
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
